<Window x:Class="SlimeHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SlimeHelper" Height="450" Width="250"
        WindowStyle="None"  
        AllowsTransparency="True" 
        Background="Transparent"
        IsHitTestVisible="True"
        Topmost="True" 
        ShowInTaskbar="False">

    <Window.ContextMenu>
        <ContextMenu
            Background="DarkGray"
            HasDropShadow="True"
            BorderBrush="Black"
            BorderThickness="1px"
            Opacity="0.9"
            IsHitTestVisible="True">
            <MenuItem Header="Chat with Slime" Click="OnOpenChatClick">
                <MenuItem.Icon>
                    <TextBlock Text="💬"/>
                </MenuItem.Icon>
            </MenuItem>

            <Separator/>

            <MenuItem Header="Volume">
                <MenuItem.Icon>
                <TextBlock Text="🔊"/>
                </MenuItem.Icon>
                <MenuItem.Items>
                    <Slider Name="VolumeSlider"
                            Width="100"
                            Minimum="0"
                            Maximum="1"
                            Value="0.5"
                            ValueChanged="VolumeChanged"/>        
                </MenuItem.Items>
            </MenuItem>

            <Separator/>

            <MenuItem Header="View Notes" Click="OnViewNotesClick">
                <MenuItem.Icon>
                    <TextBlock Text="📝"/>
                </MenuItem.Icon>
            </MenuItem>

            <Separator/>

            <MenuItem Header="Skins">
                <MenuItem.Icon>
                    <TextBlock Text="🎨"/>
                </MenuItem.Icon>
                <MenuItem Header="Blue" Click="ChangeSkin" Tag="Default"/>
                <MenuItem Header="Green" Click="ChangeSkin" Tag="Green"/>
                <MenuItem Header="Pink" Click="ChangeSkin" Tag="Pink"/>
                <MenuItem Header="Girl" Click="ChangeSkin" Tag="Girl"/>
            </MenuItem>
            
            <Separator/>

            <MenuItem Header="Settings">
                <MenuItem.Icon>
                    <TextBlock Text="⚙️"/>
                </MenuItem.Icon>

                <MenuItem Header="AI Brain">
                    <MenuItem.Icon>
                        <TextBlock Text="🧠"/>
                    </MenuItem.Icon>
                    <MenuItem Header="Gemini" Click="OnProviderChangeClick" Tag="Gemini" IsCheckable="True" x:Name="GeminiCheck"/>
                    <MenuItem Header="Claude" Click="OnProviderChangeClick" Tag="Claude" IsCheckable="True" x:Name="ClaudeCheck"/>
                </MenuItem>

                <Separator/>

                <MenuItem Header="Set Gemini API Key" Click="OnSetGeminiKeyClick">
                    <MenuItem.Icon>
                        <TextBlock Text="🔑"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Set Claude API Key" Click="OnSetClaudeKeyClick">
                    <MenuItem.Icon>
                        <TextBlock Text="🔑"/>
                    </MenuItem.Icon>
                </MenuItem>

                <Separator/>

                <MenuItem Header="GitHub Assistant">
                    <MenuItem.Icon>
                        <TextBlock Text="🐙"/>
                    </MenuItem.Icon>
                    <MenuItem Header="Set GitHub Token..." Click="OnSetGitHubTokenClick">
                        <MenuItem.Icon>
                            <TextBlock Text="🔑"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Auto-detect from gh CLI" Click="OnAutoDetectGitHubTokenClick">
                        <MenuItem.Icon>
                            <TextBlock Text="💻"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Test GitHub Connection" Click="OnTestGitHubConnectionClick">
                        <MenuItem.Icon>
                            <TextBlock Text="⚡"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>
            </MenuItem>

            <Separator/>
            
            <MenuItem Header="Set Obsidian Vault Folder" Click="OnSetObsidianVaultClick">
                <MenuItem.Icon>
                    <TextBlock Text="📓"/>
                </MenuItem.Icon>
            </MenuItem>

            <Separator/>
            
            <MenuItem Header="Set Repositories Folder" Click="OnSetReposPathClick">
                <MenuItem.Icon>
                    <TextBlock Text="📁"/>
                </MenuItem.Icon>
            </MenuItem>

            <Separator/>
            <MenuItem x:Name="CliMenuItem" Header="Install CLI to PATH" Click="InstallCliToPath_Click">
                <MenuItem.Icon>
                    <TextBlock Text="💻"/>
                </MenuItem.Icon>
            </MenuItem>

            <Separator/>
            
                <MenuItem Header="Open Browser" Click="OnOpenBrowserClick"/>
            
            <Separator/>
            
                <MenuItem x:Name="RoamingMenuItem" Header="Allow Desktop Roaming" IsCheckable="True" IsChecked="True" Click="RoamingMenuItem_Click"/>
                <MenuItem x:Name="SleepMenuItem" Header="Put to Sleep" Click="SleepMenuItem_Click"/>
            <Separator/>

            <MenuItem Header="Shut down Slime" Click="CloseApp">
                <MenuItem.Icon>
                    <TextBlock Text="❌"/>
                </MenuItem.Icon>
            </MenuItem>

        </ContextMenu>
    </Window.ContextMenu>

    <Grid VerticalAlignment="Bottom" Margin="0,0,0,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border
        x:Name="SpeechBubble"
        Grid.Row="0"
        CornerRadius="10"
        Margin="10,0,10,10"
        Padding="12"
        Visibility="Collapsed"
        Background="Beige"
        BorderBrush="Black"
        BorderThickness="1"
        MaxWidth="220"
        HorizontalAlignment="Center"
        VerticalAlignment="Bottom"
        IsHitTestVisible="True"
        Cursor="Hand"
        ToolTip="Click to open Chat"
        MouseLeftButtonUp="SpeechBubble_MouseLeftButtonUp"
        MouseEnter="SpeechBubble_MouseEnter"
        MouseLeave="SpeechBubble_MouseLeave">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.4"/>
            </Border.Effect>
            <ScrollViewer
            x:Name="SpeechScroll"
            VerticalScrollBarVisibility="Auto"
            MaxHeight="150"
            HorizontalScrollBarVisibility="Disabled"
            Padding="0,0,5,0">
                <TextBlock
                x:Name="SpeechText"
                Text="Hello Master!"
                TextWrapping="Wrap"
                FontSize="13"
                FontFamily="Segoe UI Semibold"
                TextAlignment="Left"
                Foreground="#222"/>
            </ScrollViewer>
        </Border>
        <!-- Dynamic Ground Shadow -->
        <Ellipse x:Name="SlimeShadow"
                 Grid.Row="1"
                 Width="115"
                 Height="22"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Bottom"
                 Margin="0,0,0,-6"
                 IsHitTestVisible="False"
                 RenderTransformOrigin="0.5, 0.5">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#66000000" Offset="0.0"/>
                    <GradientStop Color="#28000000" Offset="0.6"/>
                    <GradientStop Color="#00000000" Offset="1.0"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="ShadowScale" ScaleX="1" ScaleY="1"/>
                    <TranslateTransform x:Name="ShadowTranslate" X="0" Y="0"/>
                </TransformGroup>
            </Ellipse.RenderTransform>
        </Ellipse>

        <!-- Double-buffered back image for flicker-free crossfades -->
        <Image x:Name="SlimeImageBack"
               Grid.Row="1"
               Width="150"
               Stretch="Uniform"
               RenderTransformOrigin="0.5, 1.0"
               Opacity="0"
               IsHitTestVisible="False"
               RenderTransform="{Binding ElementName=SlimeImage, Path=RenderTransform}"/>

        <Image x:Name="SlimeImage"
           Grid.Row="1"
           Source="Images/slime_idle.png"
           Width="150"
           Stretch="Uniform"
           RenderTransformOrigin="0.5, 1.0"
           Opacity="0.6"
           IsHitTestVisible="True">
            <Image.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="SlimeScale" ScaleX="1" ScaleY="1"/>
                    <SkewTransform x:Name="SlimeSkew" AngleX="0" AngleY="0"/>
                    <RotateTransform x:Name="SlimeRotate" Angle="0"/>
                    <TranslateTransform x:Name="SlimeTranslate" X="0" Y="0"/>
                </TransformGroup>
            </Image.RenderTransform>
        </Image>

        <!-- Paper-Doll v1.0 Layered Character Host (active when <State>/Layers exists) -->
        <Grid x:Name="PaperDollHost"
              Grid.Row="1"
              Width="150"
              HorizontalAlignment="Center"
              VerticalAlignment="Bottom"
              Visibility="Collapsed"
              Opacity="0.6"
              RenderTransformOrigin="0.5, 1.0"
              IsHitTestVisible="True"
              RenderTransform="{Binding ElementName=SlimeImage, Path=RenderTransform}">
            <Image x:Name="PdBaseImage" Stretch="Uniform" IsHitTestVisible="True"/>
            <Image x:Name="PdEyeWhiteImage" Stretch="Uniform" IsHitTestVisible="False"/>
            <Image x:Name="PdEyesImage" Stretch="Uniform" IsHitTestVisible="False">
                <Image.RenderTransform>
                    <TranslateTransform x:Name="PdEyesTranslate" X="0" Y="0"/>
                </Image.RenderTransform>
            </Image>
            <Image x:Name="PdNoseImage" Stretch="Uniform" IsHitTestVisible="False"/>
            <Image x:Name="PdMouthImage" Stretch="Uniform" IsHitTestVisible="False"/>
            <Image x:Name="PdBlinkImage" Stretch="Uniform" Visibility="Collapsed" IsHitTestVisible="False"/>
            <Image x:Name="PdEyebrowsImage" Stretch="Uniform" IsHitTestVisible="False"/>
            <Image x:Name="PdHairLeftImage" Stretch="Uniform" RenderTransformOrigin="0.5, 0.15" IsHitTestVisible="False">
                <Image.RenderTransform>
                    <RotateTransform x:Name="PdHairLeftRotate" Angle="0"/>
                </Image.RenderTransform>
            </Image>
            <Image x:Name="PdHairMidImage" Stretch="Uniform" RenderTransformOrigin="0.5, 0.15" IsHitTestVisible="False">
                <Image.RenderTransform>
                    <RotateTransform x:Name="PdHairMidRotate" Angle="0"/>
                </Image.RenderTransform>
            </Image>
            <Image x:Name="PdHairRightImage" Stretch="Uniform" RenderTransformOrigin="0.5, 0.15" IsHitTestVisible="False">
                <Image.RenderTransform>
                    <RotateTransform x:Name="PdHairRightRotate" Angle="0"/>
                </Image.RenderTransform>
            </Image>
            <Image x:Name="PdOverlayImage" Stretch="Uniform" IsHitTestVisible="False"/>
            <Image x:Name="PdEffectImage" Stretch="Uniform" IsHitTestVisible="False"/>
            <Image x:Name="PdMotion1Image" Stretch="Uniform" IsHitTestVisible="False"/>
            <Image x:Name="PdMotion2Image" Stretch="Uniform" IsHitTestVisible="False"/>
            <Image x:Name="PdMotion3Image" Stretch="Uniform" IsHitTestVisible="False"/>
        </Grid>
        <Canvas x:Name="EmoteCanvas"
                Grid.Row="1"
                Width="220"
                Height="180"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                IsHitTestVisible="False"
                ClipToBounds="False"/>
    </Grid>
</Window>
