    <Compile Include="..\SlimeHelper\GitHubService.cs" Link="App\GitHubService.cs" />
    <Compile Include="..\SlimeHelper\GitHubWatcher.cs" Link="App\GitHubWatcher.cs" />
    <Compile Include="..\SlimeHelper\SlimeResponses.cs" Link="App\SlimeResponses.cs" />
    <Compile Include="..\SlimeHelper\GlobalWordWatcher.cs" Link="App\GlobalWordWatcher.cs" />
    <Compile Include="..\SlimeHelper\NotesManager.cs" Link="App\NotesManager.cs" />
    <Compile Include="..\SlimeHelper\ObsidianService.cs" Link="App\ObsidianService.cs" />
    <Compile Include="..\SlimeHelper\PaperDollResolver.cs" Link="App\PaperDollResolver.cs" />
  </ItemGroup>

</Project>
